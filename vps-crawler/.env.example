# Source directory to watch (latest 10 groups)
TARGET_URL=https://groupsor.link

# Your Groupsor site ingest API endpoint (use www to avoid 308 redirect)
GROUPSOR_INGEST_URL=https://www.groupsor.co.uk/api/ingest-group

# Must match INGEST_API_SECRET set on your Groupsor website server/Vercel
INGEST_API_SECRET=replace_with_a_strong_random_secret_min_32_chars

# How many top/latest groups to track from homepage
MAX_LATEST=10

# Poll interval in minutes
POLL_INTERVAL_MINUTES=5

# Optional: set to false if you want to test without posting
DRY_RUN=false

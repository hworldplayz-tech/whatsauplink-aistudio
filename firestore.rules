/**
 * @description This ruleset provides a basic secure starting point for a Firestore database.
 * It enforces that all users must be signed in to access any data.
 * @dataStructure The database has no defined structure. All paths require authentication.
 * @keySecurityDecisions All read and write operations require a valid authentication token.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Function to check if the user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Public WhatsApp Groups: anyone can view groups, submit new groups
    match /groups/{groupId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    // Taxonomies (categories & countries): publicly readable
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /countries/{countryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Site settings (moderation, layout, ads): publicly readable so the site can render
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Reports: anyone can submit a report; only admin can view/manage
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    // Secure all other paths by default, requiring authentication
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}